{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-gate.sh check",
            "timeout": 15,
            "statusMessage": "Commit gate: checking skill passes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-gate.sh post-commit",
            "timeout": 15,
            "statusMessage": "Commit gate: checking whether a mutation pass is due"
          }
        ]
      }
    ]
  }
}
